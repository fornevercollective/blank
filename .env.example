# Copy to .env or export in your shell — all optional, provider-agnostic.
# Grok build 0.1 (grok-railway-v15 when running):
# GROK_RAILWAY_URL=http://127.0.0.1:9472

# Any OpenAI-compatible local mesh (Ollama, llama.cpp server, etc.):
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434

# MCP hub / Cursor MCP config URL (if you run a local bridge):
# MCP_HUB_URL=http://127.0.0.1:3100
# MCP_CONFIG=~/.cursor/mcp.json

# Research / RAG corpus paths (grok-railway RAILWAY_RAG_PATHS pattern):
# RAILWAY_RAG_PATHS=~/models/docs,~/dev/blank/support/pages-cache

# Which provider name shows in job staging UI:
# STAGEFORGE_PROVIDER=grok-0.1

# StageForge binary (optional):
# STAGEFORGE_BIN=~/dev/stageforge/bin/stageforge
